---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import HeadshotPlaceholder from '../components/HeadshotPlaceholder.astro';
import ReviewField from '../components/ReviewField.astro';
import {
  site,
  hero,
  credibilityItems,
  expertiseGroups,
  profile,
  representativeEngagement,
} from '../data/siteContent';

const hasHeroVideo = Boolean(hero.media.videoWebm || hero.media.videoMp4);
---

<Layout
  title="McDaniel Group | Forensic Accounting & Business Valuation — Bellevue, WA"
  description="Independent forensic accounting, business valuation, economic-damages analysis, expert reporting, and testimony for counsel and closely held businesses."
  canonicalPath="/"
>
  <section class="hero-media relative isolate flex min-h-[36rem] items-end overflow-hidden bg-ink text-paper sm:min-h-[40rem] lg:min-h-[44rem]">
    <img
      src={hero.media.poster}
      width="1600"
      height="1067"
      alt={hasHeroVideo ? '' : hero.media.alt}
      fetchpriority="high"
      class:list={['hero-poster absolute inset-0 h-full w-full object-cover', hasHeroVideo && 'hero-poster-with-video']}
    />
    {hasHeroVideo && (
      <video class="hero-video absolute inset-0 h-full w-full object-cover" autoplay muted loop playsinline preload="metadata" poster={hero.media.poster} aria-hidden="true">
        {hero.media.videoWebm && <source src={hero.media.videoWebm} type="video/webm" />}
        {hero.media.videoMp4 && <source src={hero.media.videoMp4} type="video/mp4" />}
      </video>
    )}
    <div class="absolute inset-0 bg-black/65" aria-hidden="true"></div>

    <div class="page-shell relative z-10 pb-12 pt-24 sm:pb-16 lg:pb-20">
      <div class="max-w-[52rem]">
        <p class="font-sans text-xs font-medium uppercase tracking-[0.15em] text-paper/80">{hero.eyebrow}</p>
        <h1 class="mt-5 max-w-[18ch] font-serif text-[2.75rem] font-medium leading-[1.01] tracking-[-0.025em] text-paper sm:text-6xl lg:text-[4.75rem]">
          {hero.title}
        </h1>
        <p class="mt-6 max-w-[49ch] font-serif text-lg leading-relaxed text-paper/85 sm:text-xl">{hero.body}</p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-6">
          <a href="/contact" class="button-primary w-full sm:w-auto">Discuss a matter <Icon name="arrow-right" class="h-4 w-4" /></a>
          <a href={site.phoneHref} class="inline-flex min-h-11 items-center gap-2 font-sans text-sm text-paper underline decoration-paper/50 underline-offset-4 hover:decoration-paper">
            <Icon name="phone" class="h-4 w-4" /><span class="tabular-nums">{site.phone}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-rule" aria-label="Credentials and location">
    <div class="page-shell grid grid-cols-2 lg:grid-cols-4">
      {credibilityItems.map((item, index) => (
        <div class:list={[
          'min-h-28 px-4 py-5 sm:px-5 sm:py-6 lg:min-h-32 lg:px-6',
          index % 2 === 1 && 'border-l border-rule',
          index >= 2 && 'border-t border-rule lg:border-t-0',
          index === 2 && 'lg:border-l lg:border-rule',
        ]}>
          <p class:list={['font-sans text-sm font-medium leading-snug sm:text-base', item.review ? 'text-accent' : 'text-ink']}>{item.value}</p>
          <p class="mt-2 font-sans text-[0.7rem] font-medium uppercase tracking-[0.12em] text-ink-secondary">{item.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="expertise" class="page-shell section-space scroll-mt-24">
    <div class="grid gap-6 border-t border-rule pt-5 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16 lg:pt-6">
      <div>
        <p class="eyebrow">Expertise</p>
        <h2 class="mt-3 max-w-[18ch] font-serif text-3xl font-medium leading-tight sm:text-4xl">Financial analysis organized around the issue at hand.</h2>
      </div>
      <p class="body-copy max-w-[58ch] lg:pt-7">Three connected areas of practice support investigations, valuation questions, claimed losses, and the presentation of financial evidence.</p>
    </div>

    <ol class="mt-8 grid border-y border-rule lg:grid-cols-3 lg:divide-x lg:divide-rule">
      {expertiseGroups.map((group) => (
        <li class="group border-b border-rule py-7 last:border-b-0 lg:border-b-0 lg:px-7 lg:first:pl-0 lg:last:pr-0">
          <p class="eyebrow text-accent">{group.number}</p>
          <h3 class="mt-4 max-w-[16ch] font-serif text-3xl font-medium leading-tight">{group.title}</h3>
          <p class="body-copy mt-4">{group.description}</p>
          <ul class="mt-5 grid gap-2 border-t border-rule pt-4 font-sans text-sm text-ink-secondary">
            {group.items.map((item) => <li>{item}</li>)}
          </ul>
          <a href={group.href} class="text-link mt-5">Explore this expertise <Icon name="arrow-right" class="h-4 w-4" /></a>
        </li>
      ))}
    </ol>
  </section>

  <section class="page-shell section-space">
    <div class="grid gap-8 border-t border-rule pt-6 sm:gap-10 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <HeadshotPlaceholder name={site.contactName} class="home-headshot lg:min-h-[34rem]" />
      <div class="lg:self-center">
        <p class="eyebrow">The professional behind the analysis</p>
        <h2 class="mt-3 font-serif text-4xl font-medium sm:text-5xl">{site.contactName}</h2>
        <ReviewField value={profile.title} label="Professional title to confirm" class="mt-3 text-sm" />
        <ReviewField value={profile.shortBio} label="Biography to confirm" class="mt-6 max-w-[62ch]" />
        <dl class="mt-7 grid gap-5 border-y border-rule py-5 sm:grid-cols-3">
          {profile.credentials.slice(0, 3).map(([label, value]) => (
            <div>
              <dt class="eyebrow">{label}</dt>
              <dd><ReviewField value={value} label={`${label} to confirm`} class="mt-2" /></dd>
            </div>
          ))}
        </dl>
        <a href="/about" class="text-link mt-6">About Doug and professional background <Icon name="arrow-right" class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <section id="representative-work" class="page-shell section-space scroll-mt-24">
    <div class="border-t border-rule pt-6">
      <p class="eyebrow">Representative work</p>
      <div class="mt-3 grid gap-5 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <h2 class="max-w-[18ch] font-serif text-3xl font-medium leading-tight sm:text-4xl">One matter, shown through the work.</h2>
          <p class="body-copy mt-5 max-w-[38ch]">{representativeEngagement.intro}</p>
        </div>
        <article class="border-l-2 border-accent bg-paper-dim px-5 py-6 sm:px-8 sm:py-8">
          <p class="eyebrow text-accent">Case in point · Private review</p>
          <h3 class="mt-3 font-serif text-3xl font-medium">{representativeEngagement.title}</h3>
          <dl class="mt-6 divide-y divide-rule border-y border-rule">
            {representativeEngagement.details.map(([label, value]) => (
              <div class="grid gap-2 py-4 sm:grid-cols-[10rem_1fr] sm:gap-5">
                <dt class="font-sans text-xs font-medium uppercase tracking-[0.1em] text-ink-secondary">{label}</dt>
                <dd><ReviewField value={value} label={`${label} to confirm`} /></dd>
              </div>
            ))}
          </dl>
        </article>
      </div>
    </div>
  </section>

  <section class="page-shell section-space pb-12 sm:pb-16 lg:pb-24">
    <div class="grid gap-6 border-y border-rule py-8 sm:py-10 lg:grid-cols-[1fr_auto] lg:items-end lg:gap-12">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <h2 class="mt-3 max-w-[22ch] font-serif text-3xl font-medium leading-tight sm:text-4xl">Need an independent view of the financial evidence?</h2>
        <p class="body-copy mt-3">Discuss the matter with Doug McDaniel.</p>
      </div>
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center">
        <a href="/contact" class="button-primary w-full sm:w-auto">Contact Doug <Icon name="arrow-right" class="h-4 w-4" /></a>
        <a href={site.phoneHref} class="text-link px-1"><Icon name="phone" class="h-4 w-4" />{site.phone}</a>
      </div>
    </div>
  </section>
</Layout>
