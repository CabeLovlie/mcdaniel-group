---
import ReviewField from './ReviewField.astro';
interface Props { title: string; prompt: string; number: number; }
const { title, prompt, number } = Astro.props;
---
<article class="border-t border-rule py-6">
  <p class="eyebrow text-accent">0{number}</p>
  <h3 class="mt-3 font-serif text-2xl font-medium text-ink">{title}</h3>
  <ReviewField value={prompt} label="Representative matter details needed" class="mt-4" />
</article>
