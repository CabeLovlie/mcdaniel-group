---
// Inline SVG icon set, Lucide-style (24x24 viewBox, 2px stroke, round caps/joins).
// No icon font — each icon is drawn inline so it inherits `currentColor`.
interface Props {
  name:
    | 'search'
    | 'bar-chart'
    | 'shield-alert'
    | 'calculator'
    | 'scale'
    | 'building'
    | 'phone'
    | 'mail'
    | 'map-pin'
    | 'clock'
    | 'menu'
    | 'x'
    | 'award'
    | 'users'
    | 'briefcase'
    | 'arrow-right'
    | 'check-circle';
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const { name, class: className = 'w-6 h-6', ...rest } = Astro.props;
const common = {
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

{name === 'search' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <circle cx="11" cy="11" r="7" />
    <line x1="21" y1="21" x2="16.5" y2="16.5" />
  </svg>
)}

{name === 'bar-chart' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <line x1="4" y1="21" x2="21" y2="21" />
    <line x1="4" y1="21" x2="4" y2="4" />
    <rect x="7" y="13" width="3.5" height="8" />
    <rect x="13.5" y="8" width="3.5" height="13" />
    <polyline points="7 9 11 5 15 7.5 20 3" />
  </svg>
)}

{name === 'shield-alert' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z" />
    <line x1="12" y1="9" x2="12" y2="13" />
    <line x1="12" y1="16.5" x2="12" y2="16.5" />
  </svg>
)}

{name === 'calculator' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <rect x="4" y="2.5" width="16" height="19" rx="2" />
    <line x1="8" y1="6.5" x2="16" y2="6.5" />
    <line x1="8" y1="11" x2="8" y2="11" />
    <line x1="12" y1="11" x2="12" y2="11" />
    <line x1="16" y1="11" x2="16" y2="11" />
    <line x1="8" y1="15" x2="8" y2="15" />
    <line x1="12" y1="15" x2="12" y2="15" />
    <line x1="16" y1="15" x2="16" y2="18.5" />
    <line x1="8" y1="18.5" x2="8" y2="18.5" />
    <line x1="12" y1="18.5" x2="12" y2="18.5" />
  </svg>
)}

{name === 'scale' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <line x1="12" y1="3" x2="12" y2="21" />
    <line x1="6" y1="6" x2="18" y2="6" />
    <path d="M6 6l-3.5 7a3.5 3.5 0 0 0 7 0L6 6z" />
    <path d="M18 6l-3.5 7a3.5 3.5 0 0 0 7 0L18 6z" />
    <line x1="9" y1="21" x2="15" y2="21" />
  </svg>
)}

{name === 'building' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <rect x="5" y="3" width="10" height="18" />
    <rect x="15" y="9" width="5" height="12" />
    <line x1="8" y1="6.5" x2="8" y2="6.5" />
    <line x1="12" y1="6.5" x2="12" y2="6.5" />
    <line x1="8" y1="10" x2="8" y2="10" />
    <line x1="12" y1="10" x2="12" y2="10" />
    <line x1="8" y1="13.5" x2="8" y2="13.5" />
    <line x1="12" y1="13.5" x2="12" y2="13.5" />
    <line x1="8" y1="17" x2="12" y2="17" />
    <line x1="17.5" y1="12.5" x2="17.5" y2="12.5" />
    <line x1="17.5" y1="16" x2="17.5" y2="16" />
  </svg>
)}

{name === 'phone' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <path d="M5 4h3.2l1.3 4-2 1.3a12 12 0 0 0 6.2 6.2l1.3-2 4 1.3V18a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 3 5.2 2 2 0 0 1 5 4z" />
  </svg>
)}

{name === 'mail' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M3.5 6.5l8.5 6.5 8.5-6.5" />
  </svg>
)}

{name === 'map-pin' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" />
    <circle cx="12" cy="9" r="2.5" />
  </svg>
)}

{name === 'clock' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <circle cx="12" cy="12" r="9" />
    <polyline points="12 7 12 12 16 14" />
  </svg>
)}

{name === 'menu' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <line x1="4" y1="7" x2="20" y2="7" />
    <line x1="4" y1="12" x2="20" y2="12" />
    <line x1="4" y1="17" x2="20" y2="17" />
  </svg>
)}

{name === 'x' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <line x1="6" y1="6" x2="18" y2="18" />
    <line x1="18" y1="6" x2="6" y2="18" />
  </svg>
)}

{name === 'award' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <circle cx="12" cy="8" r="5.5" />
    <path d="M8.5 12.5L7 21l5-2.5 5 2.5-1.5-8.5" />
  </svg>
)}

{name === 'users' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <circle cx="9" cy="8" r="3.5" />
    <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
    <circle cx="17.5" cy="9" r="3" />
    <path d="M15.5 20a5 5 0 0 1 6 0" />
  </svg>
)}

{name === 'briefcase' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <rect x="3" y="7.5" width="18" height="12" rx="2" />
    <path d="M8 7.5V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1.5" />
    <line x1="3" y1="13" x2="21" y2="13" />
  </svg>
)}

{name === 'arrow-right' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <line x1="4" y1="12" x2="19" y2="12" />
    <polyline points="13 6 19 12 13 18" />
  </svg>
)}

{name === 'check-circle' && (
  <svg {...common} class={className} aria-hidden="true" {...rest}>
    <circle cx="12" cy="12" r="9" />
    <polyline points="8 12.5 11 15.5 16 9" />
  </svg>
)}
