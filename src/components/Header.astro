---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, navLinks } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur supports-[backdrop-filter]:bg-paper/85">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="rounded-sm">
      <Logo />
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      <ul class="flex items-center gap-8">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-sans text-sm text-ink transition-colors hover:text-accent"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={site.phoneHref}
        class="nums-tabular inline-flex items-center gap-2 border border-ink px-4 py-2 font-sans text-sm text-ink transition-colors hover:border-accent hover:text-accent"
      >
        <Icon name="phone" class="h-3.5 w-3.5" />
        <span class="tabular-nums">{site.phone}</span>
      </a>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex h-11 w-11 items-center justify-center text-ink hover:text-accent lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Open menu"
    >
      <span data-icon="open"><Icon name="menu" class="h-6 w-6" /></span>
      <span data-icon="close" hidden><Icon name="x" class="h-6 w-6" /></span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="border-t border-rule bg-paper lg:hidden" hidden>
    <ul class="mx-auto max-w-6xl space-y-1 px-4 py-4 sm:px-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block px-3 py-3 font-sans text-base text-ink hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href={site.phoneHref}
          class="flex items-center justify-center gap-2 border border-ink px-4 py-3 font-sans text-base text-ink hover:border-accent hover:text-accent"
        >
          <Icon name="phone" class="h-4 w-4" />
          <span class="tabular-nums">Call {site.phone}</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline src="/scripts/navigation.js"></script>
